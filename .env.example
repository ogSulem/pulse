# ─── Pulse ──────────────────────────────────────────────────────────────────
# Скопируйте в .env и поменяйте пароль перед публикацией на VPS:
#   cp .env.example .env && nano .env

# Пароль для входа в панель Pulse (обязательно смените!)
PULSE_PASSWORD=pulse

# Секрет для подписи сессионных токенов и шифрования токенов аккаунтов (AES-256-GCM).
# Сгенерировать:  openssl rand -hex 32
PULSE_SECRET=change-me-please-32-chars-minimum

# Публичный адрес панели. Нужен Instagram: площадка забирает видео по ссылке /media/...
# Для локального запуска можно оставить пустым — тогда Reels публикуются только после указания домена.
PULSE_PUBLIC_URL=

# Порт панели (пробрасывается наружу в docker-compose)
PULSE_PORT=8080

# Домен для HTTPS-профиля Caddy (docker compose --profile tls up -d)
PULSE_DOMAIN=pulse.example.com

# Путь к файлу БД внутри контейнера (том ./data)
PULSE_DB_PATH=/app/data/pulse.db

# Режим работы движков: demo | live
# demo — генерация и рендер симулируются, ключи API не нужны (для запуска «из коробки»)
# live — используются реальные провайдеры, ключи ниже
PULSE_MODE=demo

# Часовой пояс планировщика
PULSE_TZ=Europe/Moscow

# ─── Провайдеры (нужны только в режиме live) ────────────────────────────────
# Видео: NVIDIA NIM / Cosmos, Runway, Luma, Pika, Replicate — подключается адаптером
VIDEO_PROVIDER=nvidia
NVIDIA_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
REPLICATE_API_TOKEN=

# Озвучка
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# LLM для идей и сценариев
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Публикация (Meta Graph API / TikTok Content Posting API)
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Рендер видео (работает и в demo, и в live) ─────────────────────────────
# on — собирать mp4 и обложки; off — только сценарий и проверки (полезно на слабом VPS)
PULSE_RENDER=on
# Качество: high (1080×1920, crf 19), balanced (1080×1920, crf 22), fast (720×1280)
# Рилсы и TikTok — вертикаль 1080×1920, поэтому по умолчанию рендерим нативно
PULSE_RENDER_QUALITY=high
# Точная подстройка (перекрывает пресет качества)
PULSE_RENDER_W=1080
PULSE_RENDER_FPS=30
PULSE_RENDER_CRF=19
# Максимальная длина ролика в секундах.
#   42 — оптимум для Reels и Shorts (22–45 с);
#   65 — если нужен TikTok Creator Rewards: программа платит только за видео дольше 60 с.
# Рендер длиннее — дороже по времени примерно линейно.
PULSE_RENDER_MAX_SEC=42
# Куда писать готовые файлы (том ./data)
PULSE_MEDIA_DIR=/app/data/media
