# ─── Pulse ──────────────────────────────────────────────────────────────────
# Скопируйте в .env и поменяйте пароль перед публикацией на VPS:
#   cp .env.example .env && nano .env

# Пароль для входа в панель Pulse (обязательно смените!)
PULSE_PASSWORD=pulse

# Секрет для подписи сессионных токенов и шифрования токенов аккаунтов (AES-256-GCM).
# Сгенерировать:  openssl rand -hex 32
PULSE_SECRET=change-me-please-32-chars-minimum

# Публичный адрес панели. Нужен Instagram: площадка забирает видео по ссылке /media/...
# Для локального запуска можно оставить пустым — тогда Reels публикуются только после указания домена.
# Бесплатный вариант без домена: bash deploy/tunnel.sh (Cloudflare Quick Tunnel) → вписать выданный адрес сюда.
PULSE_PUBLIC_URL=

# Порт панели. На Railway/Render/Fly задавать не нужно — они передают PORT,
# приложение читает его первым. PULSE_PORT нужен docker compose.
PULSE_PORT=8080

# Каталог данных: база, медиа, бэкапы и секрет подписи. В контейнере — /app/data,
# это единственный том, который нужно подключать на хостинге.
PULSE_DATA_DIR=./data

# Свой бинарь ffmpeg (если не нужен встроенный или системный)
# PULSE_FFMPEG_PATH=/usr/bin/ffmpeg

# Домен для HTTPS-профиля Caddy (docker compose --profile tls up -d)
PULSE_DOMAIN=pulse.example.com

# Путь к файлу БД внутри контейнера (том ./data)
PULSE_DB_PATH=/app/data/pulse.db

# Режим работы движков: demo | live
# demo — генерация и рендер симулируются, ключи API не нужны (для запуска «из коробки»)
# live — используются реальные провайдеры, ключи ниже
PULSE_MODE=demo

# Часовой пояс планировщика
PULSE_TZ=Europe/Moscow

# ─── ИИ: идеи, сценарии, описания, библия сериалов ──────────────────────────
# Включает ИИ везде, где он может помочь. Пустой ключ = провайдер пропускается,
# платформа продолжает работать на встроенном Content Brain.
PULSE_AI=on

# Цепочка провайдеров (первый доступный выигрывает):
#   ollama → nvidia → gemini → groq → cerebras → openrouter → mistral → openai
# Все, кроме OpenAI, имеют бесплатный уровень. Достаточно ОДНОГО ключа.

# NVIDIA Build/NIM — бесплатно, ~40 запросов в минуту, без карты: build.nvidia.com
# Им же генерируются видео (Cosmos) и разметка кадров.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Google Gemini — щедрый бесплатный уровень (данные идут в обучение Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq — 30 запросов/мин бесплатно, очень быстрый: console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras — 5 запросов/мин бесплатно, но мгновенно
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter — модели с суффиксом :free (20/мин, 50/день)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# GitHub Models — бесплатно с обычным GitHub-токеном (fine-grained, права models:read).
# Ключ уже есть у любого разработчика: github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# Cloudflare Workers AI — 10 000 нейронов в день бесплатно, тот же токен, что и для картинок
# (CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_AI_TOKEN задаются ниже, в блоке картинок)
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Mistral / OpenAI — платные, но дешёвые; нужны только если нужен максимум качества
MISTRAL_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Своя Ollama на VPS: полностью бесплатно и без интернета наружу.
#   docker run -d --name ollama -p 11434:11434 ollama/ollama
#   docker exec ollama ollama pull qwen2.5:14b-instruct
PULSE_OLLAMA=off
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# Свой прокси/шлюз для ЛЮБОГО провайдера: <ID>_BASE_URL (NVIDIA_BASE_URL, GROQ_BASE_URL…).
# PULSE_LLM_BASE_URL действует только на первого провайдера в цепочке (удобно для тестов).
# PULSE_LLM_BASE_URL=
# Жёстко зафиксировать порядок или одного провайдера (через запятую / один id):
# PULSE_LLM_ORDER=gemini,groq
# PULSE_LLM_PROVIDER=nvidia

# ─── Видео ──────────────────────────────────────────────────────────────────
# nvidia (Cosmos, бесплатно с ключом), runway, luma, pika, replicate
VIDEO_PROVIDER=nvidia
NVIDIA_VIDEO_MODEL=nvidia/cosmos-1.0-diffusion-7b-text2world
RUNWAY_API_KEY=
LUMA_API_KEY=
PIKA_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_VERSION=

# ─── Озвучка ────────────────────────────────────────────────────────────────
# edge — нейронные голоса Microsoft БЕЗ ключа и без лимитов (по умолчанию).
# elevenlabs / openai — платные альтернативы, если нужен конкретный голос.
TTS_PROVIDER=edge
# ru-narrator | ru-female | en-narrator | en-female или полное имя голоса Edge
TTS_VOICE_ID=ru-narrator
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ─── Уведомления в Telegram (бесплатно) ─────────────────────────────────────
# Бот создаётся за минуту у @BotFather, chat_id узнаётся из getUpdates.
# Раз в сутки приходит сводка: что вышло, просмотры, деньги, что сломалось.
PULSE_TELEGRAM_BOT_TOKEN=
PULSE_TELEGRAM_CHAT_ID=

# ─── Публикация и вход в каналы (OAuth) ─────────────────────────────────────
# Одна кнопка «Войти через …» в разделе «Аккаунты» заменяет ручные токены:
# приложение площадки запрашивает права, Pulse сохраняет и сам продлевает токен.
# Redirect URI, который нужно вставить в кабинет разработчика:
#   <PULSE_PUBLIC_URL>/api/oauth/youtube/callback
#   <PULSE_PUBLIC_URL>/api/oauth/tiktok/callback
#   <PULSE_PUBLIC_URL>/api/oauth/reels/callback
# Без PULSE_PUBLIC_URL берётся адрес, по которому открыта панель (годится для localhost).
# (само значение задаётся выше, в начале файла)

# Meta (Instagram Reels + Facebook Pages)
META_APP_ID=
META_APP_SECRET=

# TikTok for Developers → Content Posting API (client_key, не client_id)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google Cloud → OAuth 2.0 Client (тип «Web application»), YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ─── Картинки и нейро-фото-ряд сериалов ─────────────────────────────────────
# Ключ не нужен: по умолчанию бесплатный Flux через Pollinations (анонимно,
# ~15 с между запросами). Запасной путь — Cloudflare Workers AI (10k нейронов/день).
# auto — брать нейро-кадры, если провайдер доступен; procedural — только плашки.
PULSE_IMAGE_PROVIDER=pollinations
PULSE_IMAGES=on
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Кэш кадров: data/media/frames/<sha1>.jpg — повторный рендер серии бесплатен
PULSE_IMAGE_MIN_GAP_SEC=15

# ─── Рендер видео (работает и в demo, и в live) ─────────────────────────────
# on — собирать mp4 и обложки; off — только сценарий и проверки (полезно на слабом VPS)
PULSE_RENDER=on
# Качество: high (1080×1920, crf 19), balanced (1080×1920, crf 22), fast (720×1280)
# Рилсы и TikTok — вертикаль 1080×1920, поэтому по умолчанию рендерим нативно
PULSE_RENDER_QUALITY=high
# Точная подстройка (перекрывает пресет качества)
PULSE_RENDER_W=1080
PULSE_RENDER_FPS=30
PULSE_RENDER_CRF=19
# Максимальная длина ролика в секундах.
#   42 — оптимум для Reels и Shorts (22–45 с);
#   65 — если нужен TikTok Creator Rewards: программа платит только за видео дольше 60 с.
# Рендер длиннее — дороже по времени примерно линейно.
PULSE_RENDER_MAX_SEC=42
# ─── Сериалы (16:9, 8–20 минут) ─────────────────────────────────────────────
# Длина серии, число серий в сезоне и потолок рендера живут в настройках панели
# (раздел «Настройки»): series_episode_sec, series_episodes, series_max_sec,
# series_quality, rpm_youtube_long, cost_tts_1000, cost_render_min.
# Сериал рендерится отдельным путём: 1920×1080, фото-ряд, субтитры. Пресет
# качества берётся из series_quality, а не из PULSE_RENDER_QUALITY, чтобы
# длинный рендер можно было сделать дешевле, не ломая короткие ролики.
# Озвучка серии идёт секциями по ≤3200 знаков: это лимит ElevenLabs/OpenAI.
# Выпуск по расписанию включается настройкой series_autopublish (по умолчанию 1):
# собранная серия из «В расписание» уходит задачей series.publish в общей очереди.

# Куда писать готовые файлы (том ./data)
PULSE_MEDIA_DIR=/app/data/media
